#!/usr/bin/env bash
# Starts the backend and one or more frontend instances on a dev socket.
# Ctrl-C (or closing every window) stops everything this script started.
# Run ./scripts/help for the options.
set -euo pipefail

SCRIPT="$(realpath "$0")"
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
cd "$ROOT"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# Re-run inside the flake's dev shell when started from a plain terminal.
if [[ -z "${NIX_MANAGER_ROOT:-}" ]]; then
    command -v nix >/dev/null || die "nix not found - install nix, or enter the dev shell yourself"
    flake_ref="$ROOT"
    # Flakes only see files git knows about.
    if ! git -C "$ROOT" ls-files --error-unmatch flake.nix >/dev/null 2>&1; then
        warn "flake.nix isn't tracked by git yet (git add flake.nix flake.lock); falling back to a path: flake"
        flake_ref="path:$ROOT"
    fi
    exec nix develop "$flake_ref" --command "$SCRIPT" "$@"
fi

instances=1
profile=debug
mode=both # both | backend | frontend | cli
cli_args=()

while (($#)); do
    case "$1" in
        -n|--instances) instances="${2:?missing value for $1}"; shift ;;
        -r|--release) profile=release ;;
        -c|--config-dir) export NIX_BACKEND_CONFIG_DIR="${2:?missing value for $1}"; shift ;;
        -H|--host) export NIX_BACKEND_HOST_NAME="${2:?missing value for $1}"; shift ;;
        -b|--backend-only) mode=backend ;;
        -f|--frontend-only) mode=frontend ;;
        --cli) mode=cli; shift; cli_args=("$@"); break ;;
        -h|--help) exec "$ROOT/scripts/help" ;;
        *) die "unknown option: $1 (see ./scripts/help)" ;;
    esac
    shift
done
[[ "$instances" =~ ^[0-9]+$ ]] || die "--instances needs a number, got '$instances'"

cargo_flags=()
[[ "$profile" == release ]] && cargo_flags+=(--release)

# A socket of our own, so a dev backend never replaces the socket of a real
# one: the backend deletes any existing socket file when it starts.
export NIX_BACKEND_SOCKET="${NIX_BACKEND_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/nix-manager-dev.sock}"
export RUST_LOG="${RUST_LOG:-info}"

# True if something is accepting connections on the unix socket $1.
socket_alive() {
    [[ -S "$1" ]] && command -v ss >/dev/null && ss -lxH 2>/dev/null | grep -qF -- " $1 "
}

info "Building ($profile)"
[[ $mode != frontend ]] && cargo build "${cargo_flags[@]}" --manifest-path nix-backend-generic/Cargo.toml
[[ $mode == both || $mode == frontend ]] && cargo build "${cargo_flags[@]}" -p nix-frontend-iced
[[ $mode == cli ]] && cargo build "${cargo_flags[@]}" -p nix-frontend-cli

backend_pid=
frontend_pids=()

cleanup() {
    trap - EXIT INT TERM
    ((${#frontend_pids[@]})) && kill "${frontend_pids[@]}" 2>/dev/null || true
    [[ -n "$backend_pid" ]] && kill "$backend_pid" 2>/dev/null || true
    wait 2>/dev/null || true
    [[ -n "$backend_pid" ]] && rm -f "$NIX_BACKEND_SOCKET"
}
trap cleanup EXIT INT TERM

if socket_alive "$NIX_BACKEND_SOCKET"; then
    [[ $mode == backend ]] && die "a backend is already running on $NIX_BACKEND_SOCKET"
    info "Backend already running on $NIX_BACKEND_SOCKET - attaching to it (it is not rebuilt or restarted; stop it first after backend changes)"
elif [[ $mode == frontend ]]; then
    warn "no backend on $NIX_BACKEND_SOCKET yet - the windows will keep retrying until one starts"
else
    info "Starting backend on $NIX_BACKEND_SOCKET (target: ${NIX_BACKEND_CONFIG_DIR:-/etc/nixos})"
    "$ROOT/nix-backend-generic/target/$profile/nix-backend-generic" &
    backend_pid=$!

    for _ in $(seq 100); do
        [[ -S "$NIX_BACKEND_SOCKET" ]] && break
        kill -0 "$backend_pid" 2>/dev/null || die "backend exited during startup"
        sleep 0.1
    done
    [[ -S "$NIX_BACKEND_SOCKET" ]] || die "backend did not create $NIX_BACKEND_SOCKET"
fi

if [[ $mode == backend ]]; then
    info "Backend only - attach frontends with: ./scripts/run --frontend-only (Ctrl-C to stop)"
    wait "$backend_pid"
    exit
fi

if [[ $mode == cli ]]; then
    # Not exec'd, so the trap still stops a backend we started.
    "$ROOT/target/$profile/nix-manager" "${cli_args[@]}" && status=0 || status=$?
    exit "$status"
fi

info "Starting $instances frontend instance(s)"
for ((i = 1; i <= instances; i++)); do
    "$ROOT/target/$profile/nix-frontend-iced" &
    frontend_pids+=($!)
done

# Run until every window is closed.
for pid in "${frontend_pids[@]}"; do
    wait "$pid" || true
done
